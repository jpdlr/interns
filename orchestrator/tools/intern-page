#!/usr/bin/env node
/**
 * intern-page — keep a living page JP opens from the chat (people, board,
 * table, list, draft, moodboard). See docs/features/02-pages.md and contracts.md §2.
 *
 * A page is created once and then updated in place: every write bumps its
 * version, and the app shows JP "N changes since you looked". A newly
 * created page (or one you `show`) is attached to your next reply as a
 * preview automatically — say what changed in a line; never paste the page.
 *
 * Usage:
 *   intern-page create --intern tessa --kind people --title "My people" [--summary S] (--data JSON | --data-file F) [--no-show]
 *   intern-page list --intern tessa
 *   intern-page get <page_id>
 *   intern-page show <page_id>
 *   intern-page update <page_id> [--title T] [--summary S] [--data JSON | --data-file F]
 *   intern-page patch-item <page_id> <item_id> --set '{"next_follow_up":"2026-10-09"}'   (null clears a field)
 *   intern-page add-item <page_id> --item '{"id":"p_24","name":"Danny Reyes","company":"Kettle Labs","tags":["lead"]}'
 *   intern-page patch-item <page_id> <item_id> --set '{"liked":true,"tags":["wrist","use next"]}'
 *           read current tags with get first; tags replaces the array; liked:false unlikes
 *   intern-page remove-item <page_id> <item_id>
 *   intern-page archive <page_id>
 *
 * Data shapes (kind → data):
 *   people  {"people":[{"id","name","company?","email?","tags":[],"how_met?","last_touch?":"YYYY-MM-DD","next_follow_up?":"YYYY-MM-DD","stage?","notes?","timeline?":[{"ts","kind":"mail|meeting|chat|note","text"}]}]}
 *   board   {"columns":[{"id","title"}],"items":[{"id","column","title","subtitle?","due?","person_id?"}]}
 *   table   {"columns":[{"key","title","icon?":true}],"rows":[{"id", <key>: value, …}]}
 *   list    {"items":[{"id","text","done?","tags":[],"ts"}]}
 *   draft   the JSON graph-mail draft / revise-draft prints (pass it straight through with --data-file)
 *   moodboard {"items":[{"id","title?","note?","url?","image_path?","source?","liked?":false,"tags":[]}]}
 *           visual references as image cards. A link gets its preview image fetched; image_path copies a
 *           local image (a shared photo, a downloaded post) onto the board. Each item needs a title, url, image or note.
 *
 * All output is JSON on stdout; errors are {"error": "..."} with a nonzero exit.
 */
const fs = process.getBuiltinModule("node:fs");
const os = process.getBuiltinModule("node:os");
const path = process.getBuiltinModule("node:path");

const KINDS = ["people", "board", "table", "list", "draft", "moodboard"];
const BOOLEAN_FLAGS = new Set(["no-show", "show"]);

function out(obj) {
  process.stdout.write(JSON.stringify(obj, null, 1) + "\n");
}

function die(msg, extra) {
  out({ error: msg, ...(extra ? { detail: extra } : {}) });
  process.exit(1);
}

function internsHome() {
  return process.env.INTERNS_HOME || path.join(os.homedir(), ".interns");
}

function loadConfig() {
  const file = path.join(internsHome(), "config.json");
  if (!fs.existsSync(file)) die(`no orchestrator config at ${file}`);
  let cfg;
  try {
    cfg = JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (e) {
    die(`cannot parse ${file}: ${e.message}`);
  }
  if (!cfg.api_token) die(`no api_token in ${file} — start the orchestrator once to generate it`);
  return { token: cfg.api_token, port: cfg.port || 7810 };
}

async function api(method, route, body) {
  const { token, port } = loadConfig();
  const url = `http://127.0.0.1:${port}${route}`;
  let res;
  try {
    res = await fetch(url, {
      method,
      headers: {
        Authorization: `Bearer ${token}`,
        ...(body === undefined ? {} : { "Content-Type": "application/json" }),
      },
      ...(body === undefined ? {} : { body: JSON.stringify(body) }),
      signal: AbortSignal.timeout(20000),
    });
  } catch (e) {
    const cause = e && e.cause && e.cause.code ? ` (${e.cause.code})` : "";
    die(`cannot reach the orchestrator API at ${url}${cause} — is it running?`);
  }
  const text = await res.text();
  let data = null;
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      die(`${method} ${route}: non-JSON response (HTTP ${res.status}): ${text.slice(0, 200)}`);
    }
  }
  if (!res.ok) {
    const why = data && data.error ? data.error : `HTTP ${res.status}`;
    die(`${method} ${route}: ${why}`, data && data.detail ? data.detail : undefined);
  }
  return data;
}

/** --flag value / --flag=value / bare positionals */
function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq !== -1) {
        flags[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else {
        const next = argv[i + 1];
        if (next === undefined || next.startsWith("--")) {
          if (BOOLEAN_FLAGS.has(arg.slice(2))) flags[arg.slice(2)] = "true";
          else die(`flag ${arg} needs a value`);
        } else {
          flags[arg.slice(2)] = next;
          i++;
        }
      }
    } else {
      positional.push(arg);
    }
  }
  return { flags, positional };
}

function readJson(flags, inline, file, what) {
  if (flags[file]) {
    let raw;
    try {
      raw = fs.readFileSync(flags[file], "utf8");
    } catch (e) {
      die(`cannot read --${file}: ${e.message}`);
    }
    try {
      return JSON.parse(raw);
    } catch (e) {
      die(`--${file} is not valid JSON: ${e.message}`);
    }
  }
  if (flags[inline] !== undefined) {
    try {
      return JSON.parse(flags[inline]);
    } catch (e) {
      die(`--${inline} must be JSON (${what}): ${e.message}`);
    }
  }
  return undefined;
}

const brief = (p) => ({
  page_id: p.id,
  kind: p.kind,
  title: p.title,
  summary: p.summary,
  version: p.version,
  updated_at: p.updated_at,
});

async function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
    out({ usage: USAGE });
    process.exit(argv.length === 0 ? 1 : 0);
  }
  const { flags, positional } = parseArgs(argv);
  const [cmd, id, itemId] = positional;
  const need = (v, what) => v || die(`usage: ${what}`);
  switch (cmd) {
    case "create": {
      if (!flags.intern) die("--intern is required");
      if (!KINDS.includes(flags.kind)) die(`--kind must be one of ${KINDS.join("|")}`);
      if (!flags.title) die("--title is required");
      const data = readJson(flags, "data", "data-file", "the page data");
      if (data === undefined) die("--data or --data-file is required");
      const page = await api("POST", "/pages", {
        intern: flags.intern,
        kind: flags.kind,
        title: flags.title,
        summary: flags.summary || "",
        data,
        ...(flags.thread ? { thread_key: flags.thread } : {}),
        announce: flags["no-show"] !== "true",
      });
      return { ...brief(page), note: flags["no-show"] === "true" ? "created (not shown)" : "created — its preview is attached to your reply" };
    }
    case "list": {
      if (!flags.intern) die("--intern is required");
      const res = await api("GET", `/interns/${encodeURIComponent(flags.intern)}/pages`);
      return res.pages.map((p) => ({ ...brief(p), items: p.items, pinned: p.pinned }));
    }
    case "get":
      return api("GET", `/pages/${encodeURIComponent(need(id, "intern-page get <page_id>"))}`);
    case "show": {
      await api("POST", `/pages/${encodeURIComponent(need(id, "intern-page show <page_id>"))}/show`, {});
      return { page_id: id, note: "its preview is attached to your reply" };
    }
    case "update": {
      const data = readJson(flags, "data", "data-file", "the page data");
      const body = {
        ...(flags.title ? { title: flags.title } : {}),
        ...(flags.summary !== undefined ? { summary: flags.summary } : {}),
        ...(data !== undefined ? { data } : {}),
      };
      if (Object.keys(body).length === 0) die("nothing to update: give --title, --summary, --data or --data-file");
      return brief(await api("PUT", `/pages/${encodeURIComponent(need(id, "intern-page update <page_id> …"))}`, body));
    }
    case "patch-item": {
      const set = readJson(flags, "set", "set-file", "fields to change");
      if (!set || typeof set !== "object") die("--set '{...}' is required");
      const page = await api("PATCH", `/pages/${encodeURIComponent(need(id, "intern-page patch-item <page_id> <item_id> --set JSON"))}/items/${encodeURIComponent(need(itemId, "intern-page patch-item <page_id> <item_id> --set JSON"))}`, { set });
      return brief(page);
    }
    case "add-item": {
      const item = readJson(flags, "item", "item-file", "the new item");
      if (!item || typeof item !== "object") die("--item '{...}' is required");
      return brief(await api("POST", `/pages/${encodeURIComponent(need(id, "intern-page add-item <page_id> --item JSON"))}/items`, { item }));
    }
    case "remove-item":
      return brief(await api("DELETE", `/pages/${encodeURIComponent(need(id, "intern-page remove-item <page_id> <item_id>"))}/items/${encodeURIComponent(need(itemId, "intern-page remove-item <page_id> <item_id>"))}`));
    case "archive":
      return brief(await api("POST", `/pages/${encodeURIComponent(need(id, "intern-page archive <page_id>"))}/archive`, {}));
    default:
      die(`unknown command: ${cmd}`, USAGE);
  }
}

const USAGE = [
  "intern-page create --intern <slug> --kind people|board|table|list|draft|moodboard --title T [--summary S] (--data JSON | --data-file F) [--no-show]",
  "intern-page list --intern <slug>",
  "intern-page get|show|archive <page_id>",
  "intern-page update <page_id> [--title T] [--summary S] [--data JSON | --data-file F]",
  "intern-page patch-item <page_id> <item_id> --set JSON",
  "intern-page add-item <page_id> --item JSON",
  "intern-page remove-item <page_id> <item_id>",
].join("\n");

main().then(
  (result) => out(result),
  (err) => die(err && err.message ? err.message : String(err)),
);
