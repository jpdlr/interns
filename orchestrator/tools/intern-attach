#!/usr/bin/env node
/**
 * intern-attach — send JP a file in the thread.
 *
 * Uploads a local file to the orchestrator, which stores it under the
 * intern's attachments dir and shows it in the app (inline preview for
 * images/SVG, a download chip for anything else) and in Discord. The upload
 * is linked to the reply the intern is currently writing: anything attached
 * during a task lands on that task's reply message automatically.
 *
 * Usage:
 *   intern-attach --intern tessa --file ./chart.svg [--name "Q3 spend.svg"] [--caption "Spend by week"]
 *   intern-attach list --intern tessa          # what has been exchanged in this thread
 *
 * All output is JSON on stdout; errors are {"error": "..."} with a nonzero exit.
 * Same dependency-free conventions as intern-card.
 */
const fs = process.getBuiltinModule("node:fs");
const os = process.getBuiltinModule("node:os");
const path = process.getBuiltinModule("node:path");

const MAX_BYTES = 25 * 1024 * 1024;

const MIME = {
  png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif", webp: "image/webp",
  svg: "image/svg+xml", pdf: "application/pdf", txt: "text/plain", md: "text/markdown", csv: "text/csv",
  json: "application/json", html: "text/html", zip: "application/zip",
  xlsx: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
  docx: "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
  mp3: "audio/mpeg", m4a: "audio/mp4", wav: "audio/wav", mp4: "video/mp4",
};

function out(obj) {
  process.stdout.write(JSON.stringify(obj, null, 1) + "\n");
}

function die(msg, extra) {
  out({ error: msg, ...(extra ? { detail: extra } : {}) });
  process.exit(1);
}

function internsHome() {
  return process.env.INTERNS_HOME || path.join(os.homedir(), ".interns");
}

function loadConfig() {
  const file = path.join(internsHome(), "config.json");
  if (!fs.existsSync(file)) die(`no orchestrator config at ${file}`);
  let cfg;
  try {
    cfg = JSON.parse(fs.readFileSync(file, "utf8"));
  } catch (e) {
    die(`cannot parse ${file}: ${e.message}`);
  }
  if (!cfg.api_token) die(`no api_token in ${file} — start the orchestrator once to generate it`);
  return { token: cfg.api_token, port: cfg.port || 7810 };
}

async function api(method, route, { body, contentType } = {}) {
  const { token, port } = loadConfig();
  const url = `http://127.0.0.1:${port}${route}`;
  let res;
  try {
    res = await fetch(url, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(contentType ? { "Content-Type": contentType } : {}) },
      ...(body === undefined ? {} : { body }),
      signal: AbortSignal.timeout(60000),
    });
  } catch (e) {
    const cause = e && e.cause && e.cause.code ? ` (${e.cause.code})` : "";
    die(`cannot reach the orchestrator API at ${url}${cause} — is it running?`);
  }
  const text = await res.text();
  let data = null;
  if (text) {
    try {
      data = JSON.parse(text);
    } catch {
      die(`${method} ${route}: non-JSON response (HTTP ${res.status}): ${text.slice(0, 200)}`);
    }
  }
  if (!res.ok) {
    const why = data && data.error ? data.error : `HTTP ${res.status}`;
    die(`${method} ${route}: ${why}`, data && data.detail ? data.detail : undefined);
  }
  return data;
}

/** --flag value / --flag=value / bare positionals */
function parseArgs(argv) {
  const flags = {};
  const positional = [];
  for (let i = 0; i < argv.length; i++) {
    const arg = argv[i];
    if (arg.startsWith("--")) {
      const eq = arg.indexOf("=");
      if (eq !== -1) {
        flags[arg.slice(2, eq)] = arg.slice(eq + 1);
      } else {
        const next = argv[i + 1];
        if (next === undefined || next.startsWith("--")) die(`flag ${arg} needs a value`);
        flags[arg.slice(2)] = next;
        i++;
      }
    } else {
      positional.push(arg);
    }
  }
  return { flags, positional };
}

async function cmdUpload(flags) {
  const intern = flags.intern;
  if (!intern) die("--intern is required (your slug)");
  if (!flags.file) die("--file is required");
  const file = path.resolve(flags.file);
  if (!fs.existsSync(file)) die(`no such file: ${file}`);
  const stat = fs.statSync(file);
  if (!stat.isFile()) die(`not a regular file: ${file}`);
  if (stat.size === 0) die(`file is empty: ${file}`);
  if (stat.size > MAX_BYTES) die(`file is ${stat.size} bytes; the limit is ${MAX_BYTES}`);
  const name = flags.name || path.basename(file);
  const ext = path.extname(name).slice(1).toLowerCase();
  const contentType = MIME[ext] || "application/octet-stream";
  const query = new URLSearchParams({ name, author: "intern" });
  if (flags.caption) query.set("caption", flags.caption);
  const record = await api("POST", `/interns/${encodeURIComponent(intern)}/attachments?${query}`, {
    body: fs.readFileSync(file),
    contentType,
  });
  return {
    attachment_id: record.id,
    name: record.name,
    mime: record.mime,
    kind: record.kind,
    size: record.size,
    stored_at: record.path,
    note: "attached to your current reply automatically — describe it in your message text",
  };
}

async function cmdList(flags) {
  if (!flags.intern) die("--intern is required");
  const rows = await api("GET", `/interns/${encodeURIComponent(flags.intern)}/attachments?limit=50`);
  return rows.map((a) => ({
    attachment_id: a.id,
    from: a.author,
    name: a.name,
    mime: a.mime,
    size: a.size,
    created_at: a.created_at,
    path: path.join(internsHome(), a.intern, "attachments", `${a.id}.${a.ext}`),
  }));
}

const USAGE = [
  "intern-attach --intern <slug> --file <path> [--name <display name>] [--caption <text>]",
  "intern-attach list --intern <slug>",
].join("\n");

async function main() {
  const argv = process.argv.slice(2);
  if (argv.length === 0 || argv[0] === "--help" || argv[0] === "-h") {
    out({ usage: USAGE });
    process.exit(argv.length === 0 ? 1 : 0);
  }
  const { flags, positional } = parseArgs(argv);
  const cmd = positional[0] || "upload";
  if (cmd === "upload") return cmdUpload(flags);
  if (cmd === "list") return cmdList(flags);
  die(`unknown command: ${cmd}`, USAGE);
}

main().then(
  (result) => out(result),
  (err) => die(err && err.message ? err.message : String(err)),
);
