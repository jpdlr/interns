#!/usr/bin/env python3
"""ig-research — read-only Instagram research CLI for interns.

Uses the Instagram API with Facebook Login (Meta Graph API) through the
owner's own Business or Creator account, connected in the app under
Settings › Connectors › Instagram. The connector writes
$INTERNS_HOME/instagram/config.json (mode 600) with a Page token that does
not expire; this tool only reads that file.

  ig-research whoami                         the connected account
  ig-research profile <username> [--posts N] a public Business/Creator account: bio, followers, recent posts
  ig-research hashtag <tag> [--recent] [--limit N]   top (or most recent) posts for a hashtag
  ig-research quota                          hashtags searched in the last 7 days (Instagram allows 30)

  --sheet (profile, hashtag) also draws the posts' images as one numbered
  contact sheet and prints its path: open it with Read to judge an account's
  look in one go.

  --save (profile, hashtag) keeps each post's full media under
  $INTERNS_HOME/instagram/posts/<name>-<stamp>/ to attach in the chat:
  <n>.jpg for an image, <n>.mp4 (+ <n>-cover.jpg) for a video or reel, and
  <n>-1.jpg, <n>-2.mp4, ... for a carousel's slides. Each post lists its
  "files"; "files_error" says why a post has none (no media URL, over 25 MB)
  and "files_skipped" which slides were left out.

HARD GUARDRAIL: research only. The token may carry wider permissions the
owner granted for later (publishing, comments, messages); this CLI never
uses them. Do not add publish, comment, like, follow or message commands —
anything that acts on Instagram belongs in its own capability behind an
approval card.

Every command prints JSON; failures print {"error": "..."} and exit 1.
IG_GRAPH_BASE overrides the API base (tests point it at a local fake).
"""
import argparse, http.client, json, os, re, shutil, sys, time, urllib.error, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor

GRAPH = os.environ.get("IG_GRAPH_BASE", "https://graph.facebook.com/v25.0").rstrip("/")
HASHTAG_WEEKLY_LIMIT = 30
CAPTION_MAX = 1000
USERNAME = re.compile(r"^[A-Za-z0-9._]{1,30}$")

PROFILE_FIELDS = "username,name,biography,website,followers_count,follows_count,media_count,profile_picture_url"
MEDIA_FIELDS = "id,caption,media_type,media_product_type,like_count,comments_count,timestamp,permalink,media_url,thumbnail_url"
HASHTAG_MEDIA_FIELDS = "id,caption,media_type,like_count,comments_count,timestamp,permalink,media_url"
# Carousel slides, asked for only with --save (Graph expands the nested edge
# in place); if an endpoint refuses one form, the next is tried.
CHILDREN_TRIES = (",children{media_type,media_url,thumbnail_url}", ",children{media_type,media_url}", "")
SHEET_MAX = 12
SAVE_MAX_BYTES = 25 * 1024 * 1024  # the chat app's attachment limit (intern-attach)
NO_MEDIA_URL = "Instagram gave no media URL for it (it withholds them for reels with copyrighted audio, among others)"


def die(msg, code=1):
    print(json.dumps({"error": msg}))
    sys.exit(code)


def config_path():
    home = os.environ.get("INTERNS_HOME") or os.path.expanduser("~/.interns")
    return os.path.join(home, "instagram", "config.json")


def load_config():
    try:
        with open(config_path()) as f:
            cfg = json.load(f)
    except FileNotFoundError:
        die("Instagram isn't connected. Ask the owner to connect it in Settings › Connectors › Instagram.")
    except (OSError, ValueError) as e:
        die(f"can't read the Instagram connection: {e}")
    token = cfg.get("page_token") or cfg.get("user_token")
    if not token or not cfg.get("ig_user_id"):
        die("Instagram isn't fully connected. Ask the owner to reconnect it in Settings › Connectors › Instagram.")
    return cfg, token


def explain(err, context):
    """Graph errors in words an intern can act on."""
    code, sub = err.get("code"), err.get("error_subcode")
    msg = err.get("message") or "Instagram returned an error"
    if code == 190:
        return "The Instagram connection has expired or was revoked. Ask the owner to reconnect it in Settings › Connectors › Instagram."
    if context.get("username") and (code == 110 or sub == 2207013 or "Invalid user id" in msg):
        return (f"No public Business or Creator account called @{context['username']}. "
                "Personal and private accounts can't be looked up through Instagram's API.")
    if code == 24 or sub == 2207042 or "maximum number of hashtags" in msg.lower():
        return f"This account has used its {HASHTAG_WEEKLY_LIMIT} hashtag searches for the last 7 days. Run `ig-research quota` to see which ones; searching those again is free."
    if code == 10 or code == 200:
        return f"The Instagram app doesn't have permission for this ({msg}). Ask the owner to reconnect Instagram with the permissions listed on the connector screen."
    if code in (4, 17, 32, 613):
        return "Instagram's rate limit was hit. Wait a while before trying again."
    return msg


class GraphError(Exception):
    def __init__(self, err):
        super().__init__(err.get("message"))
        self.err = err


def call(path, token, **params):
    """One Graph GET; raises GraphError with Graph's error object."""
    params["access_token"] = token
    url = f"{GRAPH}/{path}?{urllib.parse.urlencode(params)}"
    try:
        with urllib.request.urlopen(url, timeout=30) as r:
            return json.load(r)
    except urllib.error.HTTPError as e:
        try:
            err = json.load(e).get("error", {})
        except ValueError:
            err = {"message": f"HTTP {e.code}"}
        raise GraphError(err)
    except (urllib.error.URLError, TimeoutError) as e:
        die(f"can't reach Instagram: {getattr(e, 'reason', e)}")


def get(path, token, context=None, **params):
    try:
        return call(path, token, **params)
    except GraphError as e:
        die(explain(e.err, context or {}))


def get_media(path, token, context, fields, slides, **params):
    """GET with fields(extra); with slides, ask for carousel slides too, and
    if Instagram refuses that nested field here (#100), ask with less.
    Returns (body, note or None)."""
    tries = CHILDREN_TRIES if slides else ("",)
    for extra in tries[:-1]:
        try:
            return call(path, token, fields=fields(extra), **params), None
        except GraphError as e:
            if e.err.get("code") != 100:
                die(explain(e.err, context or {}))
    return (get(path, token, context, fields=fields(tries[-1]), **params),
            "Instagram wouldn't list carousel slides here, so each carousel kept only its first slide." if slides else None)


def trim(post):
    caption = post.get("caption")
    if caption and len(caption) > CAPTION_MAX:
        post["caption"] = caption[:CAPTION_MAX] + "…"
    return post


def engagement(posts, followers):
    """Averages over the returned posts; like_count is missing where the owner hid likes."""
    liked = [p["like_count"] for p in posts if isinstance(p.get("like_count"), int)]
    comments = [p["comments_count"] for p in posts if isinstance(p.get("comments_count"), int)]
    if not posts:
        return None
    avg_likes = round(sum(liked) / len(liked), 1) if liked else None
    avg_comments = round(sum(comments) / len(comments), 1) if comments else None
    rate = None
    if followers and avg_likes is not None:
        rate = round(100 * (avg_likes + (avg_comments or 0)) / followers, 3)
    return {"posts_counted": len(posts), "avg_likes": avg_likes, "avg_comments": avg_comments, "engagement_rate_pct": rate,
            "likes_hidden_on": len(posts) - len(liked)}


def take_media(posts):
    """Media URLs (and carousel slides) out of the posts, for --sheet and
    --save: they're dropped from the answer either way, being long and expiring."""
    return [{"media_type": p.get("media_type"), "media_url": p.pop("media_url", None),
             "thumbnail_url": p.pop("thumbnail_url", None),
             "children": (p.pop("children", None) or {}).get("data") or []} for p in posts]


def media_folder(kind, name):
    home = os.environ.get("INTERNS_HOME") or os.path.join(os.path.expanduser("~"), ".interns")
    stamp = time.strftime("%Y%m%d-%H%M%S")
    folder = os.path.join(home, "instagram", kind, f"{re.sub(r'[^A-Za-z0-9._-]', '_', name)}-{stamp}")
    os.makedirs(folder, exist_ok=True)
    return folder


def download(url, stem, video):
    """url → stem + .mp4/.jpg (by Content-Type, else by `video`), at most
    SAVE_MAX_BYTES. Returns (path, None) or (None, reason)."""
    tmp = stem + ".part"
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "interns-ig-research"}), timeout=60) as res:
            size = res.headers.get("Content-Length", "")
            if size.isdigit() and int(size) > SAVE_MAX_BYTES:
                return None, f"it's {int(size) / 1048576:.1f} MB, over the chat's 25 MB attachment limit"
            ctype = res.headers.get("Content-Type", "")
            ext = ".mp4" if ctype.startswith("video/") or (video and not ctype.startswith("image/")) else ".jpg"
            total = 0
            with open(tmp, "wb") as f:
                while chunk := res.read(1 << 16):
                    total += len(chunk)
                    if total > SAVE_MAX_BYTES:
                        raise OverflowError
                    f.write(chunk)
        os.replace(tmp, stem + ext)
        return stem + ext, None
    except OverflowError:
        return None, "it's over the chat's 25 MB attachment limit"
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError) as e:
        return None, f"the download failed ({getattr(e, 'reason', e)})"
    finally:
        if os.path.exists(tmp):
            os.remove(tmp)


def save(posts, media, name):
    """Each post's full media into one folder: posts gain "files" (and
    "files_error" when none could be kept). Returns (summary, per-post preview
    image or None, for the sheet to reuse)."""
    folder = media_folder("posts", name)
    jobs, plans = [], []
    for n, m in enumerate(media):
        carousel = m["media_type"] == "CAROUSEL_ALBUM" and bool(m["children"])
        plan = []
        for i, s in enumerate(m["children"] if carousel else [m]):
            stem = os.path.join(folder, f"{n + 1}-{i + 1}" if carousel else f"{n + 1}")
            video = s.get("media_type") in ("VIDEO", "REELS")
            item = {"url": s.get("media_url"), "cover": s.get("thumbnail_url"), "label": f"slide {i + 1}: " if carousel else ""}
            if item["url"]:
                jobs.append((item, "main", item["url"], stem, video))
            if item["cover"]:
                jobs.append((item, "cover_file", item["cover"], stem + "-cover", False))
            plan.append(item)
        plans.append(plan)
    with ThreadPoolExecutor(max_workers=6) as pool:
        for (item, key, *_), result in zip(jobs, pool.map(lambda j: download(*j[2:]), jobs)):
            item[key] = result
    previews, saved = [], 0
    for post, plan in zip(posts, plans):
        files, problems, preview = [], [], None
        for item in plan:
            cover = (item.get("cover_file") or (None, None))[0]
            path, reason = item.get("main") or (None, NO_MEDIA_URL)
            if path:
                kind = "video" if path.endswith(".mp4") else "image"
                files.append({"path": path, "kind": kind, "cover": cover if kind == "video" else None})
                preview = preview or (path if kind == "image" else cover)
            else:
                problems.append(f"{item['label']}{reason}" + (f"; its cover was saved: {cover}" if cover else ""))
                preview = preview or cover
        post["files"] = files
        if problems:
            post["files_error" if not files else "files_skipped"] = "; ".join(problems)
        saved += len(files)
        previews.append(preview)
    return {"folder": folder, "files": saved}, previews


def sheet(media, name, local=None):
    """Download the posts' images (a video's cover) and draw one contact
    sheet; `local` reuses images --save already downloaded."""
    if name is None:
        return None
    sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
    try:
        from _sheet import contact_sheet
    except ImportError:
        return {"error": "Pillow isn't installed (pip install -r orchestrator/tools/requirements.txt)"}
    folder = media_folder("sheets", name)
    files = []
    for n, m in enumerate(media[:SHEET_MAX]):
        path = os.path.join(folder, f"{n + 1}.jpg")
        if local and local[n]:
            shutil.copyfile(local[n], path)
            files.append(path)
            continue
        url = m["thumbnail_url"] or m["media_url"]
        if not url:
            continue
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "interns-ig-research"}), timeout=20) as res, open(path, "wb") as f:
                f.write(res.read())
            files.append(path)
        except (urllib.error.URLError, OSError, ValueError):
            continue
    out = os.path.join(folder, "sheet.jpg")
    placed = contact_sheet(files, out, labels=[os.path.basename(f)[:-4] for f in files])
    if not placed:
        return {"error": "none of the post images could be downloaded"}
    return {"path": out, "images": len(placed), "numbers": "match the post order in recent_posts / posts (1 = first)",
            "post_images": os.path.join(folder, "<number>.jpg")}


def cmd_whoami(cfg, token, _args):
    me = get(cfg["ig_user_id"], token, fields="username,name,followers_count,media_count")
    return {"username": me.get("username"), "name": me.get("name"), "followers_count": me.get("followers_count"),
            "media_count": me.get("media_count"), "page": cfg.get("page_name")}


def cmd_profile(cfg, token, args):
    username = args.username.lstrip("@")
    if not USERNAME.match(username):
        die(f"'{args.username}' isn't an Instagram username")
    n = max(1, min(args.posts, 50))
    fields = lambda extra: f"business_discovery.username({username}){{{PROFILE_FIELDS},media.limit({n}){{{MEDIA_FIELDS}{extra}}}}}"
    body, note = get_media(cfg["ig_user_id"], token, {"username": username}, fields, args.save)
    bd = body.get("business_discovery") or {}
    posts = [trim(p) for p in (bd.pop("media", None) or {}).get("data", [])]
    saved, drawn = keep(posts, username, args, note)
    return {**bd, "url": f"https://www.instagram.com/{bd.get('username', username)}/", "recent_posts": posts,
            "engagement": engagement(posts, bd.get("followers_count")), **saved, **drawn}


def keep(posts, name, args, note):
    """--save and --sheet for one command's posts → ({"saved": ...}, {"sheet": ...})."""
    media = take_media(posts)
    saved, previews = {}, None
    if args.save:
        summary, previews = save(posts, media, name)
        saved = {"saved": {**summary, **({"note": note} if note else {})}}
    drawn = sheet(media, name if args.sheet else None, previews)
    return saved, ({"sheet": drawn} if drawn else {})


def normalize_tag(raw):
    tag = raw.strip().lstrip("#").lower()
    if not tag or not all(ch.isalnum() or ch == "_" for ch in tag):
        die(f"'{raw}' isn't a hashtag Instagram can search (letters, digits and _ only; no spaces or emoji)")
    return tag


def cmd_hashtag(cfg, token, args):
    tag = normalize_tag(args.tag)
    ig = cfg["ig_user_id"]
    found = get("ig_hashtag_search", token, user_id=ig, q=tag).get("data") or []
    if not found:
        die(f"Instagram has no hashtag #{tag}")
    edge = "recent_media" if args.recent else "top_media"
    n = max(1, min(args.limit, 50))
    fields = lambda extra: HASHTAG_MEDIA_FIELDS + extra
    body, note = get_media(f"{found[0]['id']}/{edge}", token, None, fields, args.save, user_id=ig, limit=n)
    posts = [trim(p) for p in (body.get("data") or [])[:n]]
    saved, drawn = keep(posts, f"tag-{tag}", args, note)
    return {"hashtag": tag, "sort": "recent" if args.recent else "top", "url": f"https://www.instagram.com/explore/tags/{tag}/",
            "posts": posts, **saved, **drawn,
            "note": "Instagram doesn't say who posted hashtag results; open a post's permalink to see the account."}


def cmd_quota(cfg, token, _args):
    rows = get(f"{cfg['ig_user_id']}/recently_searched_hashtags", token, fields="name", limit=HASHTAG_WEEKLY_LIMIT).get("data") or []
    names = [r.get("name") for r in rows if r.get("name")]
    return {"used": len(names), "limit": HASHTAG_WEEKLY_LIMIT, "remaining": max(0, HASHTAG_WEEKLY_LIMIT - len(names)),
            "searched": names, "note": "A rolling 7 days. Searching a hashtag already on this list is free."}


def main():
    ap = argparse.ArgumentParser(prog="ig-research", description="Read-only Instagram research (public Business/Creator accounts and hashtags).")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("whoami", help="the connected account")
    p = sub.add_parser("profile", help="a public Business or Creator account: bio, followers, recent posts")
    p.add_argument("username")
    p.add_argument("--posts", type=int, default=12, help="recent posts to include (1-50, default 12)")
    p.add_argument("--sheet", action="store_true", help="also draw the first 12 posts as a contact sheet")
    p.add_argument("--save", action="store_true", help="also keep each post's full image, carousel slides and video (.mp4) to attach in the chat")
    h = sub.add_parser("hashtag", help="top or recent posts for a hashtag (30 unique hashtags per 7 days)")
    h.add_argument("tag")
    h.add_argument("--recent", action="store_true", help="newest posts (last 24 hours) instead of top posts")
    h.add_argument("--limit", type=int, default=15, help="posts to return (1-50, default 15)")
    h.add_argument("--sheet", action="store_true", help="also draw the first 12 posts as a contact sheet")
    h.add_argument("--save", action="store_true", help="also keep each post's full image, carousel slides and video (.mp4) to attach in the chat")
    sub.add_parser("quota", help="hashtags searched in the last 7 days")
    args = ap.parse_args()
    cfg, token = load_config()
    out = {"whoami": cmd_whoami, "profile": cmd_profile, "hashtag": cmd_hashtag, "quota": cmd_quota}[args.cmd](cfg, token, args)
    print(json.dumps(out, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
