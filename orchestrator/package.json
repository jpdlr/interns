{
  "name": "interns-orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interns orchestrator: a crew of persistent Claude agents run by the Coordinator",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run smoke && npm run test:schedules && npm run test:features && npm run test:connectors && npm run test:draftlearn && npm run test:reactions && npm run test:session && npm run test:photos && npm run test:moodboard && npm run test:drivesync && npm run test:github && npm run test:mailwatch && npm run test:meetingwatch && npm run test:graph-mail && npm run test:ig-research",
    "smoke": "tsx scripts/smoke.ts",
    "test:features": "tsx scripts/features.test.ts",
    "test:connectors": "tsx scripts/connectors.test.ts",
    "test:draftlearn": "tsx scripts/draftlearn.test.ts",
    "test:reactions": "tsx scripts/reactions.test.ts",
    "test:session": "tsx scripts/session.test.ts",
    "test:drivesync": "tsx scripts/drivesync.test.ts",
    "test:moodboard": "tsx scripts/moodboard.test.ts",
    "test:photos": "tsx scripts/photos.test.ts && python3 scripts/photo-library.test.py",
    "test:github": "tsx scripts/github.test.ts",
    "test:mailwatch": "tsx scripts/mailwatch.test.ts",
    "test:meetingwatch": "tsx scripts/meetingwatch.test.ts",
    "test:schedules": "tsx scripts/schedules.test.ts",
    "test:graph-mail": "python3 scripts/graph-mail.test.py && python3 scripts/graph-mail-drafts.test.py && python3 scripts/graph-mailboxes.test.py",
    "test:ig-research": "python3 scripts/ig-research.test.py",
    "setup:github": "tsx scripts/github-setup.ts",
    "setup:github-orgs": "tsx scripts/github-org-setup.ts",
    "sync:github-installations": "tsx scripts/github-installations.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.241",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.16.0",
    "fastify": "^5.4.0",
    "web-push": "^3.6.7",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  },
  "license": "MIT"
}
